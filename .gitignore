# dependencies
node_modules/

# next.js
.next/
.next-dev/
out/
next-env.d.ts

# emacs / misc
*~
*.swp

# osx
.DS_Store

# env
.env
.env.local
.env*.local

# runtime data (sqlite + uploads) — created by setup/seed
data/
*.log

# NOTE: drizzle/ is deliberately NOT ignored. The SQL files and the generated snapshot under
# drizzle/meta/ are the only record of how an instance's data moves between schema versions.
# With them untracked, a clean clone has no migrations at all and `npm run setup` fails, and a
# hand-written data migration would exist only on the machine that wrote it.

# coverage
coverage/

# typescript incremental build cache
tsconfig.tsbuildinfo
