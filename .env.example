# --- Runtime configuration (copy to .env) ---
# Path to the SQLite database file.
DATABASE_FILE=./data/casebook.db
# Directory where uploaded research data files are stored.
DATA_DIR=./data/storage
# Absolute base URL (used for absolute links in reports).
APP_URL=http://localhost:3000
# Cookie name + session TTL (days).
SESSION_COOKIE=casebook_session
SESSION_TTL_DAYS=14
# Demo researcher created by the seed script.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password

# --- Docker ---
# docker-compose.yml reads this file and overrides DATABASE_FILE/DATA_DIR with absolute
# /app/data paths so the casebook-data volume is unambiguous. To change the published host
# port, set CASEBOOK_PORT (default 3000). DEMO_EMAIL/DEMO_PASSWORD only apply when an instance
# is seeded from source; the prebuilt image ships the demo account above.
